{
  "name": "@ponsetya/core",
  "version": "1.0.0",
  "description": "Next-generation JavaScript helpers.",
  "keywords": [
    "javascript",
    "typescript",
    "helpers"
  ],
  "homepage": "https://arasekinci.github.io/ponsetya/core/getting-started",
  "bugs": "https://github.com/arasekinci/ponsetya/issues",
  "license": "MIT",
  "author": "Aras Ekinci",
  "maintainers": [
    "Aras Ekinci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arasekinci/ponsetya.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunup",
    "lint": "biome check .",
    "test": "bun test",
    "type-check": "bun check"
  },
  "dependencies": {
    "mime-db": "^1.52.0"
  },
  "devDependencies": {
    "@types/mime-db": "^1.43.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
