{
  "name": "@ponsetya/node",
  "version": "1.1.0",
  "description": "Next-generation Node.js helpers.",
  "keywords": [
    "node.js",
    "typescript",
    "helpers"
  ],
  "homepage": "https://arasekinci.github.io/ponsetya/node/getting-started",
  "bugs": "https://github.com/arasekinci/ponsetya/issues",
  "license": "MIT",
  "author": "Aras Ekinci",
  "maintainers": [
    "Aras Ekinci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arasekinci/ponsetya.git",
    "directory": "packages/node"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunup",
    "lint": "eslint src/**/*",
    "test": "bun test",
    "typecheck": "bun check"
  }
}
