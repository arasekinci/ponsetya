{
  "name": "ponsetya",
  "scripts": {
    "build:docs": "bun --filter docs run build",
    "build:packages": "bun --filter \"./packages/*\" run build",
    "build": "bun run build:packages && bun run build:docs",
    "dev:docs": "bun --filter docs run dev",
    "dev": "bun run dev:docs",
    "lint:docs": "bun --filter docs run lint",
    "lint:packages": "bun --filter \"./packages/*\" run lint",
    "lint": "bun run lint:packages && bun run lint:docs",
    "start:docs": "bun --filter docs run start",
    "start": "bun run start:docs",
    "test:packages": "bun --filter \"./packages/*\" run test",
    "test": "bun run test:packages"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.7",
    "@babel/preset-typescript": "^7.23.3",
    "@commitlint/cli": "^18.4.4",
    "@commitlint/config-conventional": "^18.4.4",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^27.6.1",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-tsdoc": "^0.2.17",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
